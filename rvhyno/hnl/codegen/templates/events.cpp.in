#include <iostream>

#include "events.h"

std::ostream& operator<<(std::ostream& os, const Event& ev) {
  os << "{"
  {%- for field in data %}
     << "{{field[0]}} = " << ev.{{field[0]}}{{' '}}
     {%- if not loop.last  -%}
         << ", "{{' '}}
     {%- endif -%}
     {% endfor %}
     << "}";
return os;
}
