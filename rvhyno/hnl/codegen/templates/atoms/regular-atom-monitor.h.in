#ifndef REGULAR_ATOM_MONITOR__{{monitor_name}}
#define REGULAR_ATOM_MONITOR__{{monitor_name}}

#include "verdict.h"
#include "atom-monitor.h"

{{cg.namespace_start()}}

/**
 * Class encapsulating the evaluation of an atom on a pair of traces.
 * This sub-class of AtomMonitor is the regular monitor that does actual evaluation.
 * There are other sub-classes (e.g., `FinishedAtomMonitor`) that represent
 * evaluated atoms, trivially satisfied atoms, etc.
 **/
class RegularAtomMonitor : public AtomMonitor {
public:
  RegularAtomMonitor(const AtomIdentifier& id) : AtomMonitor(id) {}

  Verdict step(const unsigned /* step_num */);
};

{{cg.namespace_end()}}

#endif // REGULAR_ATOM_MONITOR__{{monitor_name}}
