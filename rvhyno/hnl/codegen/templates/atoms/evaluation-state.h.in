#ifndef ATOM_{{atom_num}}_EVALUATION_STATE__{{monitor_name}}
#define ATOM_{{atom_num}}_EVALUATION_STATE__{{monitor_name}}

#include <vector>

#include "events.h"
{{include_headers}}

{{namespace_start}}

using State = int;

///
// Class representing the state of evaluation (configuration) of an automaton.
// It gathers the information in which state the automaton is,
// where it is on the input traces, and what are the values of registers.
struct Atom{{atom_num}}EvaluationState {
    State state;

    // position in the traces
    {{position_fields}}
    
    // registers
    {{registers_types}}
    {{registers_fields}}
    
    Atom{{atom_num}}EvaluationState(State s {{position_args}} {{registers_args}})
    : state(s) {{position_ctor}} {{registers_ctor}} {}
};

/**
 * This is a vector where new elements are pushed into a separate
 * storage and are moved to the main storage only on an explicit call.
 *
 * This data structure is used in the main loop of evaluating an atom
 * (automaton) for keeping the states.
 */
class Atom{{atom_num}}EvaluationStateSet
    : public std::vector<Atom{{atom_num}}EvaluationState> {
  std::vector<Atom{{atom_num}}EvaluationState> _new_cfgs;

public:
  void emplace_new(State s {{position_args}} {{registers_args}}) {
    _new_cfgs.emplace_back(s {{position_pass_args}} {{registers_pass_args}});
  }

  auto back_new() -> auto { return _new_cfgs.back(); }

  template <typename Arg> void push_new(Arg a) { _new_cfgs.push_back(a); }

  void rotate() {
    this->swap(_new_cfgs);
    _new_cfgs.clear();
  }
};

{{namespace_end}}

#endif
