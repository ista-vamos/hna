#ifdef MEASURE_CPUTIME
#include <ctime>
#endif // !MEASURE_CPUTIME

#include <cassert>
#include <iostream>

#include "formula-monitor.h"

// RVHyper headers
#include <rvhyper/Lexer.h>
#include <rvhyper/Parser.h>
#include <rvhyper/diagnostic.h>
#include <rvhyper/NoLiveMonitoring.h>
#include <rvhyper/VectorTrace.h>

{{namespace_start}}

{% set fixed, set2q, _ = cg.input_tracesets(formula) %}
FormulaMonitor::FormulaMonitor(const AllTraceSets& TS
{%- for q in fixed -%}
, Trace *{{q}}
{%- endfor -%}
):
{%- for q in fixed -%}
{%- if not loop.first -%}, {%- endif -%}
{{q}}({{q}})
{%- endfor -%}
{%- if fixed -%}, {%- endif -%}
{%- for traceset, _ in set2q.items() -%}
{%- if not traceset -%}
    {%- if not loop.first -%}, {%- endif -%}
    traces(TS.traces)
{%- else -%}
    {% set funargs = traceset.traces | join(',') -%}
    , traces_{{traceset.c_name()}}(TS.{{traceset.name}}.getTraceSet({{funargs}}))
{%- endif -%}
{%- endfor -%}
{
  // {{formula.formula}}
  using namespace rvhyper;

  Lexer *lexer = new Lexer("
  {%- for q in formula.quantifiers() -%}
  {{q.type_keyword()}} {{q.var}}.
  {%- endfor -%}
  {{formula.formula.formula}}");
  Parser parser = Parser(lexer);

  _formula = parser.parseFormula();
  if (hasNewErrors()) {
    printDiagnosticSummary();
    abort();
  }
  if (!_formula.valid()) {
    std::cerr << "HyperLTL formula is not valid." << std::endl;
    abort();
  }

  {% set reductions = cg.args.reduction or () -%}
  // Formula has these properties: {{reductions}}
  _formula.setProperties(
  "{{'r' if 'reflexive' in reductions}}{{'s' if 'symmetric' in reductions}}{{'t' if 'transitive' in reductions}}"
  );

  _monitor = std::make_unique<NoLiveMonitoring>(_formula);
}

void FormulaMonitor::addNewTraces() {
  if (auto *t_new = traces.getNewTrace()) {
    _online_traces.push_back(t_new);
  }
}

bool FormulaMonitor::handleTrace(Trace *trace) {
    /// Transform our trace to RVHyper trace
    std::vector<rvhyper::Event> events;

    for (const auto& ev : trace->events()) {
        events.emplace_back();
        auto &E = events.back();

        // RVHyper distinguishes input and output APs,
        // but it technically does not matter, so set them all
        // as input APs
        {% for name, _ in cg.args.data -%}
        if (ev.{{name}}) {
            E.input.push_back("{{name}}");
        }
        {% endfor %}
    }

    rvhyper::VectorTrace vtrace(trace->id(), events);

    /// Run RVHyper on the trace
    return _monitor->monitor(&vtrace);
}

Verdict FormulaMonitor::step() {
  Verdict verdict;

#ifdef MEASURE_CPUTIME
    struct timespec start, end;
    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &start);
#endif // !MEASURE_CPUTIME

  addNewTraces();

  auto it = _online_traces.begin();
  auto et = _online_traces.end();
  for (; it != et;) {
    Trace *trace = *it;
    if (!trace->finished()) {
        ++it;
        continue;
    }
    auto tmp = it++;
    _online_traces.erase(tmp);

    if (!handleTrace(trace)) {
        return Verdict::FALSE;
    }
  }

#ifdef MEASURE_CPUTIME
  clock_gettime(CLOCK_THREAD_CPUTIME_ID, &end);
  stats.cputime.tv_sec += (end.tv_sec - start.tv_sec);
  stats.cputime.tv_nsec += (end.tv_nsec - start.tv_nsec);
#endif // !MEASURE_CPUTIME

  bool finished = inputs_finished() && _online_traces.empty();

  if (finished) {
      return Verdict::TRUE;
  }

  return Verdict::UNKNOWN;
}


bool FormulaMonitor::inputs_finished() {
    if (_inputs_finished)
        return true;

    {% set fixed, set2q, _ = cg.input_tracesets(formula) %}
    {% for traceset, _ in set2q.items() -%}
    if (!
        {%- if not traceset -%} traces.finished()
        {%- else -%} traces_{{traceset.c_name()}}.finished()
        {%- endif -%}
       ) {
        return false;
    }
    {%- endfor %}
    {% for q in (fixed or ()) -%}
    if (!{{q}}->finished()) {
        return false;
    }
    {%- endfor %}

    _inputs_finished = true;
    return true;
}

{{namespace_end}}
