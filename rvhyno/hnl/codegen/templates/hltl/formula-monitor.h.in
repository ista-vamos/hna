// #pragma once is buggy if we generate multiple HNL monitors
// and try to include them in the HNA monitor. We have to use
// normal include guards. However, they must be different for each HNL
// monitor

#ifndef HLTL_MONITOR_H__{{monitor_name}}
#define HLTL_MONITOR_H__{{monitor_name}}

#include <vector>
#include <list>
#include <memory>

#ifdef MEASURE_CPUTIME
// There's no guarantee that chrono::high_resolution_clock will actually measure
// CPU time, so use clock_gettime from `ctime`
#include <ctime>
#endif // !MEASURE_CPUTIME

#include "verdict.h"
#include "monitor.h"
#include "trace.h"
#include "traceset.h"
#include "sharedtraceset.h"
#include "tracesetview.h"
#include "cmd.h"

#include "monitor.h"

#include "alltracesets.h"

// RVHyper
#include <rvhyper/Formula.h>

{{namespace_start}}


///
// Monitor for monitoring the body of a universally quantified HyperLTL formula,
// in particular, for:
//  `{{formula}}`
//
// That is, this is a monitor with no sub-monitors. It directly evaluates
// the body of the formula above on tuples of traces from the quantifiers.
// The evaluation is done by using RVHyper, the tool for monitoring HyperLTL.
class FormulaMonitor : public ::Monitor {
protected:

  {{input_traces}}

  // check for new traces and create Instances for them if there are some
  void addNewTraces();

  bool _inputs_finished{false};
  bool inputs_finished();

  CmdArgs *_cmd;

  rvhyper::Formula formula;

public:
  {{ctors_dtors}}

  Verdict step();

  // statistics
  struct {
    // number of HNL configurations
    size_t num_instances{0};
    // number of atom monitors
    size_t num_atoms{0};

    // CPU time taken by running the HNL monitor
    #ifdef MEASURE_CPUTIME
    struct timespec cputime{0, 0};
    struct timespec cputime_adding_instances{0, 0};
    #endif
    #ifdef CACHE_ATOMS_RESULTS
    // how many times we avoided creating a new redundant monitor
    size_t reused_monitors{0};
    size_t reused_verdict{0};
    #endif
  } stats;
};

#endif // !HLTL_ATOMS_MONITOR_H__{{monitor_name}}

{{namespace_end}}
