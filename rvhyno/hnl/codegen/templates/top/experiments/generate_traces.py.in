#/usr/bin/env python3

"""
Generate random CSV traces that can be read by the generated monitor.

Run as:
```sh
python3 ./generate_traces.py [OPTIONS]
```

This script is also used by the script `run.py` in the case that it is instructed
to generate traces. In such a case, it imports the `generate_traces` function.
(That is to say, if you modify this script and want to use `run.py`, make sure
this function persists or modify also `run.py`)
"""

from random import randint, seed
from os.path import abspath
import argparse

def generate_event(i, fl) -> None:
    """
    Generate a single event.

    Generate a single event (a row in the CSV trace) and write it
    into the opened file `fl`.
    """

    # {% for name, _ in cg.args.data -%}
    {{name}}{%- if not loop.last -%}, {% endif -%}
    {%- endfor %}
    fl.write(f'
{%- for name, annot_ty in cg.args.data -%}
    {%- set ty, vals_range = annot_ty -%}
    {%- if vals_range -%}
    {%- set l, u = data_bounds(ty, vals_range[0], vals_range[1]) -%}
    {%- else -%}
    {%- set l, u = data_bounds(ty) -%}
    {%- endif -%}
    {randint({{l}}, {{u}})}
    {%- if not loop.last -%},{%- endif -%}
{%- endfor -%}
    \n')


def generate_trace(length, fl) -> None:
    """
    Generate a trace.

    Generate a trace with length `length` and write it into
    the opened file `fl`.
    """
    for i in range(length):
        generate_event(i, fl)


def generate_traces(out_dir, num, length):
    """
    Generate `num` traces with length `length` into the directory `out_dir`.

    The script `run.py` imports this function when instructed to generate traces.
    If you modify this script and want to use `run.py`, make sure this function persists
    or modify also `run.py`.
    """
    for n in range(1, num + 1):
        with open(f"{out_dir}/trace-{n}.tr", "w") as tf:
            generate_trace(length, tf)


if __name__ == "__main__":

    ######################################################################
    # Get arguments and do the setup
    ######################################################################
    parser = argparse.ArgumentParser(description='Generate random traces')
    parser.add_argument('-o', '--out-dir', default="random-traces",
                        help="Directory where to generate traces")
    parser.add_argument('-l', '--len', default=10,
                        help="Length of traces (default is 10 to make them simple")
    parser.add_argument('-n', '--num', default=10,
                        help="The number of traces (default is 10 to make them simple")

    args = parser.parse_args()

    seed() # initialize random numbers

    ######################################################################
    # Generate the traces
    ######################################################################

    generate_traces(abspath(args.out_dir), args.num,  args.len)

    exit(0)
