#ifndef HNL_SUB_MONITOR_H__{{monitor_name}}
#define HNL_SUB_MONITOR_H__{{monitor_name}}

#include <vector>
#include <memory>

#include "monitor.h"
#include "verdict.h"
#include "traceset.h"

/* generated */
#include "alltracesets.h"
#include "instance.h"

{{cg.namespace_start()}}

///
// This class is an HNL monitor that does not handle atoms but nested monitors
// in cases when there is quantifier alternation:
// In cases when the formula is `forall ..., exists ...: F`,
// we create a nested monitor M for the negation of `exists ...: F` and
// use it from HNLSubMonitor that monitors `forall ...: !M`.
//
// Monitor for `{{formula}}`
class FormulaMonitor : public ::Monitor {
  const AllTraceSets& TS;

  {% set fixed, set2q, _ = cg.input_tracesets(formula) %}
  {% for q in fixed -%}
  Trace *{{q}};  /* fixed */
  {%- endfor %}
  {% for traceset, q in set2q.items() -%}
  TraceSetView
  {% if not traceset -%} traces
  {%- else -%} traces_{{traceset.c_name()}}
  {%- endif -%};
  {% endfor %}

  // Here we store the instances of formula to process.
  // Each instance has a reference to its monitor, so we do
  // not store monitors explicitly anywhere.
  std::vector<std::unique_ptr<Instance>> _instances;

  void addNewTraces();
  void condenseWbg();

  bool _inputs_finished{false};
  bool inputs_finished();

public:
  FormulaMonitor(const AllTraceSets& TS
  {%- for q in cg.input_tracesets(formula)[0] -%} , Trace *{{q}} {%- endfor -%}
  );

  Verdict step();

  void noFutureUpdates() { abort(); }

  // statistics
  struct {
    // number of HNL configurations
    size_t num_instances{0};

    // CPU time taken by running the HNL monitor
   //#ifdef MEASURE_CPUTIME
   //struct timespec cputime{0, 0};
   //struct timespec cputime_adding_instances{0, 0};
   //#endif
  } stats;
};

#endif // !HNL_SUB_MONITOR_H__{{monitor_name}}

{{cg.namespace_end()}}
