#include <cassert>

#include "formula-monitor.h"

{{cg.namespace_start()}}

{% set fixed, set2q, _ = cg.input_tracesets(formula) %}
FormulaMonitor::FormulaMonitor(const AllTraceSets& TS
{%- for q in fixed -%}
, Trace *{{q}}
{%- endfor -%}
): TS(TS)
{%- for q in fixed -%}
, {{q}}({{q}})
{%- endfor -%}
{%- for traceset, _ in set2q.items() -%}
{%- if not traceset -%}
    , traces(TS.traces)
{%- else -%}
    {% set funargs = traceset.traces | join(',') -%}
    , traces_{{traceset.c_name()}}(TS.{{traceset.name}}.getTraceSet({{funargs}}))
{%- endif -%}
{%- endfor -%}
{}

void FormulaMonitor::addNewTraces() {
  {% for line in cg.read_generated_file('_create-instances.h') -%}
  {{line}}
  {%- endfor %}
}

{% if negate_submonitor_verdict %}
static inline Verdict negate_verdict(Verdict v) {
    assert(v != Verdict::UNKNOWN);
    return v == Verdict::FALSE ? Verdict::TRUE : Verdict::FALSE;
}
{% endif %}

Verdict FormulaMonitor::step() {
  Verdict verdict;

  unsigned empty_slots{0};
  const auto n_monitors = _instances.size();

  for (unsigned n = 0; n < n_monitors; ++n) {
      auto &instance = _instances[n];
      if (!instance) {
          ++empty_slots;
          continue;
      }
      if ((verdict = instance->monitor->step()) != Verdict::UNKNOWN) {
          // this monitor is done
          _instances[n].reset();
          ++empty_slots;

          {% if negate_submonitor_verdict %}
          // the monitor evaluates negated formula, so negate the verdict back
          // (the formula was negated to obtain a universally quantified sub-formula
          // instead of existentially quantified)
          verdict = negate_verdict(verdict);
          {% endif %}

          if (verdict == Verdict::FALSE) {
              // FIXME: we leak memory (which is bad, because this FALSE may not be the final result
              // and the monitors may run further)
              return verdict;
          }
      }
  }

  if (static_cast<float>(empty_slots) / n_monitors > 0.3) {
      condenseWbg();
  }

  addNewTraces();
  bool finished = inputs_finished() && _instances.empty();

  if (finished) {
      return Verdict::TRUE;
  }

  return Verdict::UNKNOWN;
}

bool FormulaMonitor::inputs_finished() {
    if (_inputs_finished)
        return true;

    {% set fixed, set2q, _ = cg.input_tracesets(formula) %}
    {% for traceset, _ in set2q.items() -%}
    if (!
        {%- if not traceset -%} traces.finished()
        {%- else -%} traces_{{traceset.c_name()}}.finished()
        {%- endif -%}
       ) {
        return false;
    }
    {%- endfor %}
    {% for q in (fixed or ()) -%}
    if (!{{q}}->finished()) {
        return false;
    }
    {%- endfor %}


    _inputs_finished = true;
    return true;
}


void FormulaMonitor::condenseWbg() {
    if (_instances.empty())
        return;

    // FIXME: do it in place without creating a new vector
    decltype(_instances) tmp;
    tmp.reserve(_instances.size());

    for (auto &ptr : _instances) {
        if (ptr) {
            tmp.push_back(std::move(ptr));
        }
    }
    _instances.swap(tmp);
}

{{cg.namespace_end()}}
