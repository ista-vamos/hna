int ch;

{% for d in data %}
{% set name, annot_ty = d %}
{% set ty, val_range = annot_ty -%}

{# read the data field #}
_stream >> ev.{{name}};
if (_stream.fail()) {
    {% if loop.first %} {# is this the first event in the row? #}
    if (_events_num_read == 0) {
      // assume this is the header and skip this row
      // FIXME: check that the header matches the events
      _stream.clear();
      _stream.ignore(std::numeric_limits<std::streamsize>::max(), '\n');

      // try reading the event again
      _stream >> ev.{{name}};
      if (_stream.fail()) {
           std::cerr << _file << ":" << _events_num_read + 1 << ": failed reading column '{{name}}' of expected type `{{ty}}`\n";
           abort();
      }
    } else {
        std::cerr << _file << ": failed reading column `{{name}}` on line " << _events_num_read + 1 << "\n";
        abort();
    }
    {% else %} {# this is definitely not a header, fail #}
        std::cerr << _file << ": failed reading column `{{name}}` on line " << _events_num_read + 1 << "\n";
        abort();
    {% endif %}
}
{% if val_range %}
if (ev.{{name}} < {{val_range[0]}} || ev.{{name}} > {{val_range[1]}}) {
    std::cerr << _file << ": the value for column `{{name}}` on line " << _events_num_read + 1 << " is out of range: "
              << ev.{{name}} << " not in  [{{val_range[0]}}..{{val_range[1]}}]\\n";
    abort();
}
{% endif %}
{% if loop.last %}
// check the end of the read line
while ((ch = _stream.get()) != EOF) {
  if (ch == '\n') {
    break;
  }
  if (!std::isspace(ch)) {
    std::cerr << "In file `" << _file << "`\n";
    std::cerr << "Wrong input on line " << _events_num_read + 1 << " after reading column `{{name}}`\n";
    std::cerr << "Expected the end of line, got `" << static_cast<char>(ch) << "`\n";
    abort();
  }
}
{% else %}
// find the next field
while ((ch = _stream.get()) != EOF) {
  if (ch == ',') {
    break;
  }
  if (!std::isspace(ch) || ch == '\n') {
    std::cerr << _file << ": wrong input on line " << _events_num_read + 1 << " after reading column `{{name}}`\n";
    std::cerr << "Expected next column (',' character), got '" << static_cast<char>(ch) << "'\n";
    abort();
  }
}
{% endif %}

{% endfor %}
